  {
    "type": "sura",
    "surah_number": 84,
    "name": "Al-Inshiqaq",
    "arabic_name": "سُورَةُ الِانْشِقَاقِ",
    "revelation": "Makkah",
    "ayah_count": 25,
    "juz": 30,
    "intro": "Sura hii inaitwa Al-Inshiqaq, yaani Kupasuka, kwa kuwa inazungumzia kupasuka kwa mbingu Siku ya Qiyaama na kumtii Mola wake. Inaeleza hali ya watu siku hiyo: wale wataopewa kitabu kwa mkono wa kulia na wale wataopewa kwa nyuma, na inathibitisha kuwa binadamu atarudi kwa Mola wake.",
    "content": [
      { "number": 1, "page": 1492, "arabic": "إِذَا السَّمَاءُ انشَقَّتْ", "translation": "Pindi mbingu itakapopasuka Siku ya Kiyama." },
      { "number": 2, "page": 1492, "arabic": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ", "translation": "Na ikatii amri ya Mola wake ya kuwa ipasuke, na inastahili kufuata amri hiyo." },
      { "number": 3, "page": 1492, "arabic": "وَإِذَا الْأَرْضُ مُدَّتْ", "translation": "Na pindi ardhi itakapotandikwa na kukunjuliwa. Na milima yake kuvunjwa vunjwa Siku hiyo." },
      { "number": 4, "page": 1492, "arabic": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ", "translation": "Na ikatoa iliyoyabeba ndani yake miongoni mwa maiti." },
      { "number": 5, "page": 1492, "arabic": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ", "translation": "Na ikatii amri ya Mola wake ya kuwa ifanye hivyo, (na inastahili kufuata amri hiyo)." },
      { "number": 6, "page": 1492, "arabic": "يَا أَيُّهَا الْإِنسَانُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَاقِيهِ", "translation": "Ewe binadamu, wewe unaenda kwa Allah Mtukufu na unafanya amali nzuri na mbaya, kisha utakutana naye Siku ya Kiyama. Na huna budi kupata kutoka Kwake malipo mazuri zaidi ya amali yako njema, au yanayolingana na amali yako mbaya." },
      { "number": 7, "page": 1492, "arabic": "فَأَمَّا مَنْ أُوتِيَ كِتَابَهُ بِيَمِينِهِ", "translation": "Yule mwenye kupewa waraka wa amali zake kwa mkono wake wa kulia, naye ni yule aliyemuamini Mola wake." },
      { "number": 8, "page": 1492, "arabic": "فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا", "translation": "Atahesabiwa hesabu Nyepesi." },
      { "number": 9, "page": 1492, "arabic": "وَيَنقَلِبُ إِلَىٰ أَهْلِهِ مَسْرُورًا", "translation": "Na atarudi kwa watu wake Peponi akiwa ni mwenye furaha." },
      { "number": 10, "page": 1492, "arabic": "وَأَمَّا مَنْ أُوتِيَ كِتَابَهُ وَرَاءَ ظَهْرِهِ", "translation": "Na yule mwenye kupewa waraka wa amali zake kwa nyuma ya mgongo wake, naye ni yule aliyemkanusha Allah Mtukufu." },
      { "number": 11, "page": 1493, "arabic": "فَسَوْفَ يَدْعُو ثُبُورًا", "translation": "Ataita maangamivu na hasara." },
      { "number": 12, "page": 1493, "arabic": "وَيَصْلَىٰ سَعِيرًا", "translation": "Na ataingia Motoni." },
      { "number": 13, "page": 1493, "arabic": "إِنَّهُ كَانَ فِي أَهْلِهِ مَسْرُورًا", "translation": "Hakika alikuwa kwa watu wake ulimwenguni ni mwenye furaha na majivuno, hafikirii mwisho wake utakuwa namna gani." },
      { "number": 14, "page": 1493, "arabic": "إِنَّهُ ظَنَّ أَن لَّن يَحُورَ", "translation": "Hakika alidhani hatarudi kwa Muumba wake, akiwa hai, (ili kuhesabiwa)." },
      { "number": 15, "page": 1493, "arabic": "بَلَىٰ إِنَّ رَبَّهُ كَانَ بِهِ بَصِيرًا", "translation": "Sivyo hivyo! Allah Mtukufu Atamrudisha kama alivyomuumba na kumlipa kwa amali zake. Kwani Yeye kwake ni Mtambuzi, na kwa hali yake ni Mjuzi, kuanzia Alipomuumba mpaka kumfufua." },
      { "number": 16, "page": 1494, "arabic": "فَلَا أُقْسِمُ بِالشَّفَقِ", "translation": "Allah Mtukufu Ameapa kwa wekundu wa pembe za mbingu wakati wa kuzama jua." },
      { "number": 17, "page": 1494, "arabic": "وَاللَّيْلِ وَمَا وَسَقَ", "translation": "Na kwa usiku na ulivyokusanya miongoni mwa viumbe tofauti tofauti vya kutambaa, kuruka na kutembea kwa miguu." },
      { "number": 18, "page": 1494, "arabic": "وَالْقَمَرِ إِذَا اتَّسَقَ", "translation": "Na kwa mwezi ukamilikapo mwangaza wake." },
      { "number": 19, "page": 1494, "arabic": "لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍ", "translation": "Mtapitia, enyi watu, miongo mbalimbali na hali tofauti : kutoka kwenye tone la manii, kupitia panda la damu, nofu la nyama hadi kutiwa roho, mpaka kufa na mpaka kufufuliwa. Haifai kwa kiumbe kuapa kwa asiyekuwa Allah Mtukufu, afanyapo hilo atakuwa ameingia kwenye ushirikina." },
      { "number": 20, "page": 1494, "arabic": "فَمَا لَهُمْ لَا يُؤْمِنُونَ", "translation": "Ni kitu gani kinachowazuia wao kumwamini Allah Mtukufu na Siku ya Kiyama baada ya aya zake kufafanuliwa kwao?" },
      { "number": 21, "page": 1494, "arabic": "وَإِذَا قُرِئَ عَلَيْهِمُ الْقُرْآنُ لَا يَسْجُدُونَ", "translation": "Na wana nini wao wanaposomewa Qur'ani hawamsujudii Allah Mtukufu wala hawajisalimishi kufuata yaliyokuja ndani yake?" },
      { "number": 22, "page": 1494, "arabic": "بَلِ الَّذِينَ كَفَرُوا يُكَذِّبُونَ", "translation": "Hakika tabia ya waliokufuru ni kuikanusha na kuikataa haki." },
      { "number": 23, "page": 1494, "arabic": "وَاللَّهُ أَعْلَمُ بِمَا يُوعُونَ", "translation": "Na Allah Mtukufu ni Mjuzi zaidi wa ukaidi wao wanaouficha kwenye nyoyo zao hali wao wanajua kuwa yale yaliyoletwa na Qur'ani ni kweli." },
      { "number": 24, "page": 1494, "arabic": "فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ", "translation": "Basi wape bishara, ewe Mtume, kuwa Allah Mtukufu, Aliyetukuka na kuwa juu, Amewaandalia adhabu yenye uchungu." },
      { "number": 25, "page": 1494, "arabic": "إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ", "translation": "Lakini wale wanaomuamini Allah Mtukufu na Mtume wake na wakatekeleza amri waliyofaradhiwa na Allah Mtukufu watakuwa na malipo, Siku ya Akhera, yasiyokatika wala kupungua." }
    ]
  }
